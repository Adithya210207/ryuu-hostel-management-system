{
  "name": "ryuu",
  "version": "1.0.0",
  "private": true,
  "description": "Ryuu hostel website and self-hosted resident portal",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4174",
    "dev:phone": "node scripts/phone-preview.cjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "worker": "tsx scripts/worker.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "backup": "tsx scripts/backup.ts",
    "setup:push": "tsx scripts/setup-push.ts",
    "prestart": "node --env-file-if-exists=.env.production --import tsx scripts/preflight.ts --startup",
    "check:production": "node --env-file-if-exists=.env.production --import tsx scripts/preflight.ts",
    "test:production": "tsx scripts/production-smoke.ts",
    "backup:verify": "tsx scripts/verify-backup.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "exceljs": "4.4.0",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "nodemailer": "^10.0.11",
    "pdfkit": "0.20.2",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-push": "^3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "^3.6.4",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
