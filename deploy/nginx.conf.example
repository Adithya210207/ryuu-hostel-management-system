# Install on the host running Docker. Replace hostel.example.com and certificate paths.
# Keep the app bound to 127.0.0.1:3000; do not expose PostgreSQL publicly.
limit_req_zone $binary_remote_addr zone=ryuu_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=ryuu_api:10m rate=10r/s;

server {
    listen 80;
    server_name hostel.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name hostel.example.com;
    ssl_certificate /etc/letsencrypt/live/hostel.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hostel.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 9m;
    client_body_timeout 20s;
    client_header_timeout 20s;
    keepalive_timeout 30s;
    limit_req_status 429;

    location /api/auth/ {
        limit_req zone=ryuu_auth burst=15 nodelay;
        proxy_pass http://127.0.0.1:3000;
        include /etc/nginx/snippets/ryuu-proxy.conf;
    }
    location /api/ {
        limit_req zone=ryuu_api burst=30 nodelay;
        proxy_pass http://127.0.0.1:3000;
        include /etc/nginx/snippets/ryuu-proxy.conf;
    }
    location / {
        proxy_pass http://127.0.0.1:3000;
        include /etc/nginx/snippets/ryuu-proxy.conf;
    }
}
