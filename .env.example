# Copy to .env.local for development. Never commit real credentials.
APP_URL=http://127.0.0.1:4174
# Explicitly local only; never honored in production.
DEMO_MODE=true
# Production starts with registration closed; open only after commissioning.
REGISTRATION_OPEN=false
# Total retained document storage per account, MB.
UPLOAD_STORAGE_LIMIT_MB=256
# Leave empty to use embedded PostgreSQL for single-process local development.
DATABASE_URL=
DATA_DIR=.data
BACKUP_DIR=backups
# Set only for a backup after web and worker writes have been stopped.
BACKUP_WRITES_PAUSED=false
# Production: 32 random bytes, base64. Back this up SEPARATELY from files.
FILE_ENCRYPTION_KEY=
# Production requires an installed ClamAV scanner executable.
CLAMSCAN_PATH=
# First admin setup via npm run bootstrap; no shipped password.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=
# One Gmail account for authentication emails only. Use a Google App Password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_DAILY_LIMIT=400
# WhatsApp Cloud API: signed-in phone verification only, never login/recovery/reminders.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=
WHATSAPP_LANGUAGE=en_US
WHATSAPP_AUTH_TEMPLATE=
# Phone push notifications. Generate stable keys with npm run setup:push -- mailto:you@gmail.com
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Signed event adapter; actual biometric device integration is still deferred.
DEVICE_INGEST_SECRET=

# Opt in to real Gmail OTP delivery while using synthetic preview accounts.
PREVIEW_REAL_EMAIL=false

# PhonePe Payment Gateway (Standard Checkout). Keys: PhonePe Business Dashboard > Developer Settings.
# Leave PHONEPE_CLIENT_ID empty to hide the Pay with PhonePe button (bank transfer + proof still works).
# Webhook URL to register in the dashboard: https://<your-site>/api/payments/phonepe/webhook
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
# Local demo only: a fake checkout page to try the flow without PhonePe keys.
PHONEPE_SIMULATE=false

# true = use the owner's logo/render in public/images (not in git); false = neutral placeholders
NEXT_PUBLIC_OWNER_BRANDING=false

# Public showcase on a production build: demo accounts, synthetic data, embedded DB, uploads off. Never for a real launch.
# SHOWCASE_MODE=true
