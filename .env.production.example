# Copy to .env.production on the server. Fill secrets privately; never commit them.
APP_URL=https://replace-with-your-domain.example
DEMO_MODE=false
REGISTRATION_OPEN=false
# Generate a long random hexadecimal password. Compose supplies DATABASE_URL.
POSTGRES_PASSWORD=
# For running without Compose, set the real PostgreSQL connection below.
DATABASE_URL=
DATA_DIR=/app/.data
BACKUP_DIR=/app/backups
BACKUP_WRITES_PAUSED=false
UPLOAD_STORAGE_LIMIT_MB=256
# Generate 32 random bytes encoded as base64; keep a separate recovery copy.
FILE_ENCRYPTION_KEY=
CLAMSCAN_PATH=/usr/bin/clamscan
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_DAILY_LIMIT=400
# Official WhatsApp authentication template, only for phone verification.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=
WHATSAPP_LANGUAGE=en_US
WHATSAPP_AUTH_TEMPLATE=
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Hardware optional until the scanner is selected and commissioned.
DEVICE_INGEST_SECRET=

# PhonePe Payment Gateway (Standard Checkout). Keys: PhonePe Business Dashboard > Developer Settings.
# Leave PHONEPE_CLIENT_ID empty to hide the Pay with PhonePe button (bank transfer + proof still works).
# Webhook URL to register in the dashboard: https://<your-site>/api/payments/phonepe/webhook
PHONEPE_ENV=production
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
